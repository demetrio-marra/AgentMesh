{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "BaseUrl": "https://amcodepipeline.dem-k8s.home/",
    "ApiKey": "dev-api-key",
    "HeaderName": "X-Api-Key"
