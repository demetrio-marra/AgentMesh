  "ConversationSummarization": {
    "SummaryTokenThreshold": 10000,
    "NumMessageToPreseve": 6,
    "SummarizeLanguage": "Italian"
  },
  "ChatContext": {
    "IdleExpirationMinutes": 120
  }
}