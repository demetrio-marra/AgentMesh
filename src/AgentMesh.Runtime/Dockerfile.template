FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY NuGet.config ./
COPY MyPlugin/MyPlugin.csproj ./MyPlugin/
RUN dotnet restore MyPlugin/MyPlugin.csproj

COPY MyPlugin ./MyPlugin/
RUN dotnet publish MyPlugin/MyPlugin.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 8080
ENV ASPNETCORE_HTTP_PORTS=8080

ENTRYPOINT ["dotnet", "MyPlugin.dll"]