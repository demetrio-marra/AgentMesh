@model ChatPageViewModel
@{
    ViewData["Title"] = "Chat";
}

<main class="app-shell">
    <header class="topbar">
        <a class="brand" asp-action="Index">AgentMesh</a>
        <div class="topbar-actions">
            <button id="diagnostics-toggle" class="control-button" type="button" aria-expanded="false">Diagnostics</button>
            <button id="new-chat" class="control-button" type="button">New chat</button>
        </div>
    </header>
    <section class="chat-workspace">
        <section class="chat-panel" aria-label="Conversation">
            <div id="transcript" class="transcript" aria-live="polite">
                <div class="empty-state">Conversation is empty</div>
            </div>
            <footer class="composer-area">
                <div class="counters"><span id="token-count">0 tokens</span><span id="cost-count">$0.00</span></div>
                <form id="composer" class="composer">
                    <label class="sr-only" for="message">Message</label>
                    <textarea id="message" name="message" rows="2" placeholder="Write a message" required></textarea>
                    <div class="action-slot">
                        <button id="send" class="primary-button" type="submit">Send</button>
                        <button id="stop" class="stop-button" type="button" hidden>Stop</button>
                    </div>
                </form>
            </footer>
        </section>
    </section>
</main>

<div id="terminal-toasts" class="terminal-toasts" aria-live="polite" aria-atomic="true"></div>

<div id="diagnostics-modal" class="diagnostics-modal" hidden>
    <section class="diagnostics-dialog" role="dialog" aria-modal="true" aria-labelledby="diagnostics-title">
        <div class="diagnostics-heading">
            <h2 id="diagnostics-title">Diagnostics</h2>
            <button id="diagnostics-close" class="icon-button" type="button" aria-label="Close diagnostics">x</button>
        </div>
        <div class="diagnostics-tabs">
            <div class="diagnostics-tablist" role="tablist" aria-label="Diagnostics views">
                <button id="diagnostics-summary-tab" class="diagnostics-tab is-selected" type="button" role="tab" aria-selected="true" aria-controls="diagnostics-summary-panel">Summary</button>
                <button id="diagnostics-steps-tab" class="diagnostics-tab" type="button" role="tab" aria-selected="false" aria-controls="diagnostics-steps-panel" tabindex="-1">Steps details</button>
                <button id="diagnostics-parameters-tab" class="diagnostics-tab" type="button" role="tab" aria-selected="false" aria-controls="diagnostics-parameters-panel" tabindex="-1">Parameters by Step</button>
                <button id="diagnostics-raw-tab" class="diagnostics-tab" type="button" role="tab" aria-selected="false" aria-controls="diagnostics-raw-panel" tabindex="-1">Raw data</button>
                <button id="diagnostics-configuration-tab" class="diagnostics-tab" type="button" role="tab" aria-selected="false" aria-controls="diagnostics-configuration-panel" tabindex="-1">Configuration</button>
            </div>
            <div id="diagnostics-summary-panel" class="diagnostics-tabpanel diagnostics-summary-panel" role="tabpanel" aria-labelledby="diagnostics-summary-tab">
                <div id="diagnostics-summary" class="diagnostics-summary"></div>
            </div>
            <div id="diagnostics-steps-panel" class="diagnostics-tabpanel diagnostics-steps-panel" role="tabpanel" aria-labelledby="diagnostics-steps-tab">
                <div id="diagnostics-step-list" class="diagnostics-step-list" aria-label="Workflow steps"></div>
                <div id="diagnostics-step-details" class="diagnostics-step-details" aria-live="polite"></div>
            </div>
            <div id="diagnostics-parameters-panel" class="diagnostics-tabpanel diagnostics-parameters-panel" role="tabpanel" aria-labelledby="diagnostics-parameters-tab" hidden>
                <div id="diagnostics-parameters-by-step" class="diagnostics-parameters-by-step" aria-live="polite"></div>
            </div>
            <div id="diagnostics-raw-panel" class="diagnostics-tabpanel" role="tabpanel" aria-labelledby="diagnostics-raw-tab" hidden>
                <textarea id="diagnostics-output" class="diagnostics-output" readonly aria-label="Workflow diagnostics"></textarea>
            </div>
            <div id="diagnostics-configuration-panel" class="diagnostics-tabpanel diagnostics-configuration-panel" role="tabpanel" aria-labelledby="diagnostics-configuration-tab" hidden>
                @if (Model.Configuration is { } configuration)
                {
                    <dl class="configuration-list">
                        <div><dt>Sandbox</dt><dd>@configuration.SandboxName</dd></div>
                        <div><dt>Endpoint</dt><dd>@configuration.SandboxServiceUrl</dd></div>
                        <div><dt>Agent</dt><dd>@configuration.AgentId</dd></div>
                    </dl>
                    <h3>Configured agents</h3>
                    <ul class="agent-list">
                        @foreach (var agent in configuration.Agents)
                        {
                            <li><strong>@agent.AgentRole</strong><span>@agent.Provider / @agent.Model</span></li>
                        }
                    </ul>
                }
                else
                {
                    <p class="configuration-error">@Model.ConfigurationError</p>
                }
            </div>
        </div>
    </section>
</div>